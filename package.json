{
  "name": "dsh-plugin-paper-theme",
  "version": "0.1.2",
  "description": "可选的 DSH 全局纸面主题，亮暗模式与字体跟随宿主",
  "license": "MIT",
  "author": "Tavlo-dsh",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": ["index.js", "client.js", "cordis.patch.yml", "locale/*.json", "README.md", "LICENSE", "docs/*.md", "docs/*.json", "docs/screenshots/**/*.png"],
  "keywords": ["dsh-plugin", "theme", "paper", "tavlo"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": { "platform": "web" }
  },
  "engines": { "dsh": "0.2.2-rc.1" },
  "scripts": { "test": "node --test tests/*.test.mjs" },
  "dependencies": { "@deepseek-ai/schemastery": "3.19.0" }
}
