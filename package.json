{
  "name": "@tavlo-dsh/dsh-plugin-paper-theme",
  "version": "0.1.2",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "description": "DSH 的 iOS 圆角与纸面主题，支持任务看板单独切换",
  "license": "MIT",
  "author": "Tavlo-dsh",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tavlo-dsh/tavlo-plugins-paper-theme.git"
  },
  "homepage": "https://github.com/Tavlo-dsh/tavlo-plugins-paper-theme#readme",
  "bugs": {
    "url": "https://github.com/Tavlo-dsh/tavlo-plugins-paper-theme/issues"
  },
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": ["index.js", "client.js", "cordis.patch.yml", "locale/*.json", "README.md", "LICENSE", "docs/*.md", "docs/*.json", "docs/screenshots/**/*.png"],
  "keywords": ["dsh-plugin", "theme", "paper", "tavlo"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": { "platform": "web" }
  },
  "engines": { "dsh": "0.2.2-rc.1" },
  "scripts": { "test": "node --test tests/*.test.mjs" },
  "dependencies": { "@deepseek-ai/schemastery": "3.19.0" }
}
